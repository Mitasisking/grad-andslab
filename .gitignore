# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase CLI local cache
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# real inventory data, not source
export.csv

# scripts/simulate-minor-test.js's own record of what it created, consumed
# by scripts/teardown-minor-test.js -- not source, and disposable
scripts/.minor-test-manifest.json
scripts/.major-test-manifest.json

.vercel

# local scratch notes with real payment-provider credentials -- not secrets
# files Next.js knows about (those are .env*, already ignored above), just
# plaintext notes kept for reference until they're moved into .env.local
resend dot com.txt
stripe.txt
stripe trigger payment.txt
